# The CLI does not apply .gitignore to a linked project, so the working store
# and its 128 MB journal have to be excluded again here. `data/buildobjects.prod.db`
# — the snapshot the deployment actually opens — is deliberately not listed.
node_modules
.next
.git
*.tsbuildinfo

data/buildobjects.db
data/buildobjects.db-wal
data/buildobjects.db-shm
data/logs

# Collector inputs and run outputs. Nothing on the query path reads these; the
# catalogue they produced is already inside the snapshot.
collector/raw
collector/fixtures
data/snapshots
screenshots
tests

# The stitch research folder: the reverse-engineered originals, proof captures
# and brand fonts behind lib/stitch/. Nothing on the site imports it.
stitch-clone
